rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function daysSinceEpoch(ts) {
      return int(ts.toMillis() / 86400000);
    }

    // Reads the CALLER's own /users/{uid} document. get()/exists() calls
    // inside rules are not themselves subject to security rules, so this
    // does not recurse — it's a safe, standard pattern.
    function callerExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && callerExists() && callerData().role == role;
    }

   function callerClassId() {
     return callerExists() ? callerData().get('assignedClassId', callerData().get('classId', null)) : null;
    }

    function allowedRosterFields() {
      return [
        'totalGirlBoarders',
        'totalGirlDayScholars',
        'totalBoyBoarders',
        'totalBoyDayScholars',
        'totalGirls',
        'totalBoys',
        'totalBoarders',
        'totalDayScholars',
        'totalStudents'
      ];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR') ||
        request.auth.uid == userId
      );

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == null &&
        request.resource.data.classId == null;

      allow update: if isSignedIn() && (
        (
          // A user may touch their own doc, but may NOT change their
          // own role/status/classId this way — that always requires a
          // privileged caller via the branches below.
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.classId == resource.data.classId
        ) || (
          // Director can assign/clear Admin, Class Teacher, School Manager
          hasRole('DIRECTOR') &&
          request.auth.uid != userId &&
          request.resource.data.role in ['ADMIN', 'CLASS TEACHER', 'SCHOOL MANAGER', null]
        ) || (
          // ICT Coordinator can only assign/clear Class Teacher
          hasRole('ICT COORDINATOR') &&
          request.auth.uid != userId &&
          (request.resource.data.role == 'CLASS TEACHER' || request.resource.data.role == null)
        )
      );

      allow delete: if isSignedIn() && (
        hasRole('DIRECTOR') || hasRole('ICT COORDINATOR')
      );
    }

    match /attendance_logs/{document=**} {
      allow read: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR') ||
        (hasRole('CLASS TEACHER') && (resource == null || resource.data.classId == callerClassId()))
      );
      allow create: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR') ||
        (hasRole('CLASS TEACHER') && request.resource.data.classId == callerClassId())
      );
      allow update: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR') ||
        (
          hasRole('CLASS TEACHER') &&
          request.auth.uid == resource.data.submittedByUid &&
          resource.data.classId == callerClassId() &&
          daysSinceEpoch(request.time) == daysSinceEpoch(resource.data.timestamp)
        )
      );
      allow delete: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR') ||
        (hasRole('CLASS TEACHER') && resource.data.classId == callerClassId())
      );
    }
    
    match /terms/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR')
      );
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR')
      );
      allow update: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR') ||
        (
          (hasRole('CLASS TEACHER') || hasRole('TEACHER')) &&
          classId == callerClassId() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedRosterFields())
        )
      );
      allow delete: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('ADMIN') ||
        hasRole('ICT COORDINATOR')
      );
    }

    match /dailyLogs/{document=**} {
      allow read: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('SCHOOL MANAGER')
      );
      allow create, update, delete: if isSignedIn() && hasRole('SCHOOL MANAGER');
    }

    match /kitchenRecords/{recordId} {
      allow read: if isSignedIn() && (
        hasRole('DIRECTOR') ||
        hasRole('SCHOOL MANAGER')
      );
      allow write: if isSignedIn() && hasRole('SCHOOL MANAGER');
    }
    
    match /schoolEvents/{eventId} {
  allow read: if isSignedIn();
  allow create, update, delete: if isSignedIn() && (
    hasRole('DIRECTOR') ||
    hasRole('ADMIN') ||
    hasRole('ICT COORDINATOR')
  );
}
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'ICT COORDINATOR' ||
        request.auth.uid == userId
      );
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == null &&
        request.resource.data.classId == null;
      allow update: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ICT COORDINATOR' ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.classId == resource.data.classId
        )
      );
      allow delete: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ICT COORDINATOR'
      );
    }

    match /attendance_logs/{document=**} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SCHOOL MANAGER' ||
        (request.auth.token.role == 'CLASS TEACHER' && resource.data.classId == request.auth.token.classId)
      );
      allow create: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        (request.auth.token.role == 'CLASS TEACHER' && request.resource.data.classId == request.auth.token.classId)
      );
      allow update: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        (
          request.auth.token.role == 'CLASS TEACHER' &&
          resource.data.classId == request.auth.token.classId &&
          request.resource.data.classId == request.auth.token.classId
        )
      );
      allow delete: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        (request.auth.token.role == 'CLASS TEACHER' && resource.data.classId == request.auth.token.classId)
      );
    }

    match /terms/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'ICT COORDINATOR'
      );
    }

    match /classes/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'ICT COORDINATOR'
      );
    }

    match /kitchenRecords/{document=**} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'DIRECTOR' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SCHOOL MANAGER'
      );
      allow write: if request.auth != null && request.auth.token.role == 'SCHOOL MANAGER';
    }
  }
}
